# ── Banco de Dados ────────────────────────────────────────────────────────────
# Local (SQLite)
DATABASE_URL=sqlite:///./geldmacht.db
# Produção (Supabase PostgreSQL)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
# Produção
# CORS_ORIGINS=https://geldmacht.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Geldmacht API
DEBUG=false

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=troque-isto-em-producao
ALGORITHM=HS256
# Expiração do access token (minutos). Dev/teste: 10080 (7 dias).
# Produção: defina explicitamente o valor desejado (recomenda-se algo menor).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Usuário de teste (somente dev/teste) ──────────────────────────────────────
# Quando true, cria no startup o usuário teste@agente.com / teste@123 (idempotente).
# NUNCA habilitar em produção.
SEED_TEST_USER=false
